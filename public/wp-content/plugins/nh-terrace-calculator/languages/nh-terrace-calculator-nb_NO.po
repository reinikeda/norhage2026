msgid "Multiwall: whole 2100 mm sheets, length rounded up to a full metre (1–7 m). Solid: whole 2050 × 3050 mm sheets, either way up."
msgstr "Flerlags: hele 2100 mm plater, lengde avrundet opp til hele meter (1–7 m). Massiv: hele 2050 × 3050 mm plater, begge veier."

#, php-format
msgid "Neutral silicone"
msgstr "Nøytral silikon"

#, php-format
msgid "Neutral silicone Silirub PC"
