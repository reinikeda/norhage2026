msgid "Cart is not available."
msgstr "Handlekurven er ikke tilgjengelig."

msgid "No matching products were found for this configuration. Check the SKU mapping in Terrace calculator settings."
msgstr "Fant ingen produkter som passer til dette valget. Sjekk SKU-koblingen i innstillingene for terrassekalkulatoren."

msgid "Unable to add one of the kit items to the basket."
msgstr "Kunne ikke legge til en av varene i handlekurven."

msgid "Terrace roof kit added to basket."
msgstr "Terrassetak-settet er lagt i handlekurven."

#, php-format
msgid "A sheet would be wider than the %d mm stock. Reduce the support spacing so every piece can be cut from a standard sheet."
msgstr "En plate ville blitt bredere enn lagerbredden på %d mm. Reduser lekteavstanden slik at hvert stykke kan kappes fra en standardplate."

msgid "The last sheet would be too narrow to cut. Adjust the support spacing so each piece is at least 100 mm."
msgstr "Den siste platen ville blitt for smal til å kappes. Juster lekteavstanden slik at hvert stykke er minst 100 mm."

msgid "Enter a support beam width between 20 and 200 mm. 50 mm is the usual size."
msgstr "Skriv inn en bjelkebredde mellom 20 og 200 mm. 50 mm er vanlig."

msgid "Sheet overhang must be between 0 and 300 mm."
msgstr "Plateoverhenget må være mellom 0 og 300 mm."

msgid "Please enter a valid width and length."
msgstr "Skriv inn gyldig bredde og lengde."

msgid "Wood screws with washers"
msgstr "Treskruer med skiver"

msgid "Connecting profile"
msgstr "Forbindelsesprofil"

msgid "Wall profile 2.2 m"
msgstr "Veggprofil 2,2 m"

msgid "Ridge profile 2.2 m"
msgstr "Møneprofil 2,2 m"

msgid "Ventilation sealing tape"
msgstr "Ventilasjonstape"

msgid "Insulation sealing tape"
msgstr "Isolasjonstape"

msgid "Clamping profile end cap"
msgstr "Endepropp til klemprofil"

msgid "EPDM rubber gasket 50 mm"
msgstr "EPDM-gummipakning 50 mm"

msgid "Neutral silicone Silirub PC"
msgstr "Nøytral silikon Silirub PC"

msgid "Polycarbonate sheet"
msgstr "Polykarbonatplate"

