msgid "Cart is not available."
msgstr "Varukorgen är inte tillgänglig."

msgid "No matching products were found for this configuration. Check the SKU mapping in Terrace calculator settings."
msgstr "Inga produkter matchade det här valet. Kontrollera SKU-kopplingen i inställningarna för terrasskalkylatorn."

msgid "Unable to add one of the kit items to the basket."
msgstr "Kunde inte lägga till en av varorna i varukorgen."

msgid "Terrace roof kit added to basket."
msgstr "Terrasstak-satsen har lagts i varukorgen."

#, php-format
msgid "A sheet would be wider than the %d mm stock. Reduce the support spacing so every piece can be cut from a standard sheet."
msgstr "En skiva skulle bli bredare än lagerbredden på %d mm. Minska regelavståndet så att varje bit kan kapas från en standardskiva."

msgid "The last sheet would be too narrow to cut. Adjust the support spacing so each piece is at least 100 mm."
msgstr "Den sista skivan skulle bli för smal att kapa. Justera regelavståndet så att varje bit är minst 100 mm."

msgid "Enter a support beam width between 20 and 200 mm. 50 mm is the usual size."
msgstr "Ange en regelbredd mellan 20 och 200 mm. 50 mm är det vanliga måttet."

msgid "Sheet overhang must be between 0 and 300 mm."
msgstr "Skivöverhänget måste vara mellan 0 och 300 mm."

msgid "Please enter a valid width and length."
msgstr "Ange en giltig bredd och längd."

msgid "Wood screws with washers"
msgstr "Träskruv med bricka"

msgid "Connecting profile"
msgstr "Skarvprofil"

msgid "Wall profile 2.2 m"
msgstr "Väggprofil 2,2 m"

msgid "Ridge profile 2.2 m"
msgstr "Nockprofil 2,2 m"

msgid "Ventilation sealing tape"
msgstr "Ventilationstejp"

msgid "Insulation sealing tape"
msgstr "Isoleringstejp"

msgid "Clamping profile end cap"
msgstr "Ändlock till klämprofil"

msgid "EPDM rubber gasket 50 mm"
msgstr "EPDM-gummilist 50 mm"

msgid "Neutral silicone Silirub PC"
msgstr "Neutral silikon Silirub PC"

