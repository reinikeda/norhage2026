msgstr "Sienos profilis 2,2 m"

msgid "Ridge profile 2.2 m"
msgstr "Kraigo profilis 2,2 m"

msgid "Ventilation sealing tape"
msgstr "Vėdinimo juosta"

msgid "Insulation sealing tape"
msgstr "Izoliacinė sandarinimo juosta"

