msgid "Cart is not available."
msgstr "Krepšelis nepasiekiamas."

msgid "No matching products were found for this configuration. Check the SKU mapping in Terrace calculator settings."
msgstr "Šiam pasirinkimui prekių nerasta. Patikrinkite SKU sąsają terasos skaičiuoklės nustatymuose."

msgid "Unable to add one of the kit items to the basket."
msgstr "Vienos komplekto prekės nepavyko įdėti į krepšelį."

msgid "Terrace roof kit added to basket."
msgstr "Terasos stogo komplektas įdėtas į krepšelį."

#, php-format
msgid "A sheet would be wider than the %d mm stock. Reduce the support spacing so every piece can be cut from a standard sheet."
msgstr "Lakštas būtų platesnis už %d mm sandėlio plotį. Sumažinkite atramų žingsnį, kad kiekvieną dalį būtų galima išpjauti iš standartinio lakšto."

msgid "The last sheet would be too narrow to cut. Adjust the support spacing so each piece is at least 100 mm."
msgstr "Paskutinis lakštas būtų per siauras pjauti. Pakoreguokite atramų žingsnį, kad kiekviena dalis būtų bent 100 mm."

msgid "Enter a support beam width between 20 and 200 mm. 50 mm is the usual size."
msgstr "Įveskite sijos plotį nuo 20 iki 200 mm. Įprasta 50 mm."

msgid "Sheet overhang must be between 0 and 300 mm."
msgstr "Lakšto užlaida turi būti nuo 0 iki 300 mm."

msgid "Please enter a valid width and length."
msgstr "Įveskite tinkamą plotį ir ilgį."

msgid "Wood screws with washers"
msgstr "Medsraigčiai su poveržlėmis"

msgid "Connecting profile"
msgstr "Jungiamasis profilis"

