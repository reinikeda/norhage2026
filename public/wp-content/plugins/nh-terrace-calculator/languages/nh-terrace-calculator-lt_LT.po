msgstr "Įveskite sijos plotį nuo 20 iki 200 mm. Įprasta 50 mm."

msgid "Sheet overhang must be between 0 and 300 mm."
msgstr "Lakšto užlaida turi būti nuo 0 iki 300 mm."

