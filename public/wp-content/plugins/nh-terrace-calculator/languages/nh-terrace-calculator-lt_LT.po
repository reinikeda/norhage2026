msgstr "Terasos stogo skaičiuoklė"

msgid "Work through the steps, check the cut list, and add a complete kit to the basket. Sheets are cut so every joint lands on the centre of a support."
msgstr "Pereikite žingsnius, patikrinkite pjovimo sąrašą ir įdėkite visą komplektą į krepšelį. Lakštai pjaunami taip, kad kiekviena siūlė būtų atramos centre."

msgid "Roof shape"
msgstr "Stogo forma"

msgid "Lean-to"
msgstr "Vienšlaitis"

msgid "Gable"
msgstr "Dvišlaitis"

msgid "Polycarbonate"
msgstr "Polikarbonatas"

msgid "Material"
msgstr "Medžiaga"

