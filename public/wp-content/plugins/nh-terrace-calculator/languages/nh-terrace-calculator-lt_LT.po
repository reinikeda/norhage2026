msgstr "Numatytasis gegnių žingsnis (ašinis)"

msgid "Centre-to-centre distance between supports when the customer leaves CC empty. Standard is 600 mm."
msgstr "Atramos nuo centro iki centro, kai klientas palieka lauką tuščią. Įprasta 600 mm."

msgid "Support beam and sheet overhang"
msgstr "Atraminė sija ir lakšto užlaida"

msgid "Beam width"
msgstr "Sijos plotis"

msgid "Joint gap"
msgstr "Siūlės tarpas"

