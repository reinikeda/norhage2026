msgstr "Spalva"

msgid "Frame size"
msgstr "Rėmo matmenys"

msgid "Width along the wall"
msgstr "Plotis palei sieną"

msgid "Frame length (projection)"
msgstr "Rėmo ilgis (iškyša)"

msgid "Support spacing (centre to centre)"
msgstr "Atramų žingsnis (nuo centro iki centro)"

