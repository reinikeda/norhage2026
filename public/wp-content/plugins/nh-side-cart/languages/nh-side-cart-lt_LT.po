msgid "Basket"
msgstr "Krepšelis"

msgid "Close basket"
msgstr "Uždaryti krepšelį"

msgid "Your basket is empty"
msgstr "Jūsų krepšelis tuščias"

msgid "Add products to see shipping costs by postcode."
msgstr "Pridėkite prekių, kad pagal pašto kodą pamatytumėte pristatymo kainą."

msgid "Continue shopping"
msgstr "Tęsti apsipirkimą"

msgid "Remove %s from basket"
msgstr "Pašalinti %s iš krepšelio"

msgid "Qty: %d"
msgstr "Kiekis: %d"

msgid "Decrease quantity"
msgstr "Sumažinti kiekį"

msgid "Increase quantity"
msgstr "Padidinti kiekį"

msgid "Quantity"
msgstr "Kiekis"

msgid "Calculate shipping"
msgstr "Skaičiuoti pristatymą"

msgid "Enter your postcode to see the shipping cost."
msgstr "Įveskite pašto kodą, kad pamatytumėte pristatymo kainą."

msgid "Country / region"
msgstr "Šalis / regionas"

msgid "Select a country / region…"
msgstr "Pasirinkite šalį / regioną…"

msgid "Postcode / ZIP"
msgstr "Pašto kodas"

msgid "Show shipping cost"
msgstr "Rodyti pristatymo kainą"

msgid "Free pickup from the warehouse is also available."
msgstr "Galimas ir nemokamas atsiėmimas iš sandėlio."

msgid "No shipping methods available for this postcode."
msgstr "Šiam pašto kodui nėra pristatymo būdų."

msgid "Subtotal"
msgstr "Tarpinė suma"

msgid "Coupon: %s"
msgstr "Kuponas: %s"

msgid "Shipping"
msgstr "Pristatymas"

msgid "Total"
msgstr "Iš viso"

msgid "Enter postcode"
msgstr "Įveskite pašto kodą"

msgid "View basket"
msgstr "Peržiūrėti krepšelį"

msgid "Checkout"
msgstr "Apmokėti"

msgid "Updating…"
msgstr "Atnaujinama…"

msgid "Could not update the basket. Please try again."
msgstr "Nepavyko atnaujinti krepšelio. Bandykite dar kartą."

msgid "Basket is not available."
msgstr "Krepšelis nepasiekiamas."

msgid "Unknown basket action."
msgstr "Nežinomas krepšelio veiksmas."

msgid "Basket item not found."
msgstr "Krepšelio prekė nerasta."

msgid "Could not update the quantity."
msgstr "Nepavyko atnaujinti kiekio."

msgid "Could not remove the item."
msgstr "Nepavyko pašalinti prekės."

msgid "Please select a country / region."
msgstr "Pasirinkite šalį / regioną."

msgid "Please enter a postcode."
msgstr "Įveskite pašto kodą."

msgid "Please enter a valid postcode / ZIP."
msgstr "Įveskite galiojantį pašto kodą."

msgid "Shipping costs updated."
msgstr "Pristatymo kaina atnaujinta."

msgid "Please choose a shipping method."
msgstr "Pasirinkite pristatymo būdą."

msgid "Norhage Side Cart is active. Deactivate Side Cart WooCommerce (XootiX) so customers only see one basket drawer."
msgstr "Norhage Side Cart įjungtas. Išjunkite Side Cart WooCommerce (XootiX), kad pirkėjai matytų tik vieną krepšelio langą."

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d prekė"
msgstr[1] "%d prekės"
msgstr[2] "%d prekių"
