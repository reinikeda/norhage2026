msgid "Basket"
msgstr "Kurv"

msgid "Close basket"
msgstr "Luk kurven"

msgid "Your basket is empty"
msgstr "Din kurv er tom"

msgid "Add products to see shipping costs by postcode."
msgstr "Tilføj produkter for at se fragtomkostning efter postnummer."

msgid "Continue shopping"
msgstr "Fortsæt med at handle"

msgid "Remove %s from basket"
msgstr "Fjern %s fra kurven"

msgid "Qty: %d"
msgstr "Antal: %d"

msgid "Decrease quantity"
msgstr "Reducer antal"

msgid "Increase quantity"
msgstr "Øg antal"

msgid "Quantity"
msgstr "Antal"

msgid "Calculate shipping"
msgstr "Beregn fragt"

msgid "Enter your postcode to see the shipping cost."
msgstr "Indtast dit postnummer for at se fragtomkostningen."

msgid "Country / region"
msgstr "Land / region"

msgid "Select a country / region…"
msgstr "Vælg et land / en region…"

msgid "Postcode / ZIP"
msgstr "Postnummer"

msgid "Show shipping cost"
msgstr "Vis fragtomkostning"

msgid "No shipping methods available for this postcode."
msgstr "Ingen fragtmetoder tilgængelige for dette postnummer."

msgid "Subtotal"
msgstr "Subtotal"

msgid "Coupon: %s"
msgstr "Rabatkode: %s"

msgid "Shipping"
msgstr "Fragt"

msgid "Total"
msgstr "I alt"

msgid "Enter postcode"
msgstr "Indtast postnummer"

msgid "View basket"
msgstr "Se kurv"

msgid "Checkout"
msgstr "Til kassen"

msgid "Updating…"
msgstr "Opdaterer…"

msgid "Could not update the basket. Please try again."
msgstr "Kurven kunne ikke opdateres. Prøv igen."

msgid "Basket is not available."
msgstr "Kurven er ikke tilgængelig."

msgid "Unknown basket action."
msgstr "Ukendt kurvhandling."

msgid "Basket item not found."
msgstr "Varen blev ikke fundet i kurven."

msgid "Could not update the quantity."
msgstr "Antallet kunne ikke opdateres."

msgid "Could not remove the item."
msgstr "Varen kunne ikke fjernes."

msgid "Please select a country / region."
msgstr "Vælg et land / en region."

msgid "Please enter a postcode."
msgstr "Indtast et postnummer."

msgid "Please enter a valid postcode / ZIP."
msgstr "Indtast et gyldigt postnummer."

msgid "Shipping costs updated."
msgstr "Fragtomkostningerne er opdateret."

msgid "Please choose a shipping method."
msgstr "Vælg en fragtmetode."

msgid "Norhage Side Cart is active. Deactivate Side Cart WooCommerce (XootiX) so customers only see one basket drawer."
msgstr "Norhage Side Cart er aktiv. Deaktiver Side Cart WooCommerce (XootiX), så kunderne kun ser én kurv."

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d vare"
msgstr[1] "%d varer"
