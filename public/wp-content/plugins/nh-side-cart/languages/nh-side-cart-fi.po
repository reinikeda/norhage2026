msgid "Basket"
msgstr "Ostoskori"

msgid "Close basket"
msgstr "Sulje ostoskori"

msgid "Your basket is empty"
msgstr "Ostoskorisi on tyhjä"

msgid "Add products to see shipping costs by postcode."
msgstr "Lisää tuotteita nähdäksesi toimituskulut postinumeron perusteella."

msgid "Continue shopping"
msgstr "Jatka ostoksia"

msgid "Remove %s from basket"
msgstr "Poista %s ostoskorista"

msgid "Qty: %d"
msgstr "Määrä: %d"

msgid "Decrease quantity"
msgstr "Vähennä määrää"

msgid "Increase quantity"
msgstr "Lisää määrää"

msgid "Quantity"
msgstr "Määrä"

msgid "Calculate shipping"
msgstr "Laske toimituskulut"

msgid "Enter your postcode to see the shipping cost."
msgstr "Syötä postinumerosi nähdäksesi toimituskulut."

msgid "Country / region"
msgstr "Maa / alue"

msgid "Select a country / region…"
msgstr "Valitse maa / alue…"

msgid "Postcode / ZIP"
msgstr "Postinumero"

msgid "Show shipping cost"
msgstr "Näytä toimituskulut"

msgid "No shipping methods available for this postcode."
msgstr "Tälle postinumerolle ei ole toimitustapoja."

msgid "Subtotal"
msgstr "Välisumma"

msgid "Coupon: %s"
msgstr "Alennuskoodi: %s"

msgid "Shipping"
msgstr "Toimitus"

msgid "Total"
msgstr "Yhteensä"

msgid "Enter postcode"
msgstr "Syötä postinumero"

msgid "View basket"
msgstr "Näytä ostoskori"

msgid "Checkout"
msgstr "Kassa"

msgid "Updating…"
msgstr "Päivitetään…"

msgid "Could not update the basket. Please try again."
msgstr "Ostoskoria ei voitu päivittää. Yritä uudelleen."

msgid "Basket is not available."
msgstr "Ostoskori ei ole käytettävissä."

msgid "Unknown basket action."
msgstr "Tuntematon ostoskoritoiminto."

msgid "Basket item not found."
msgstr "Ostoskorin tuotetta ei löytynyt."

msgid "Could not update the quantity."
msgstr "Määrää ei voitu päivittää."

msgid "Could not remove the item."
msgstr "Tuotetta ei voitu poistaa."

msgid "Please select a country / region."
msgstr "Valitse maa / alue."

msgid "Please enter a postcode."
msgstr "Syötä postinumero."

msgid "Please enter a valid postcode / ZIP."
msgstr "Syötä kelvollinen postinumero."

msgid "Shipping costs updated."
msgstr "Toimituskulut päivitetty."

msgid "Please choose a shipping method."
msgstr "Valitse toimitustapa."

msgid "Norhage Side Cart is active. Deactivate Side Cart WooCommerce (XootiX) so customers only see one basket drawer."
msgstr "Norhage Side Cart on käytössä. Poista Side Cart WooCommerce (XootiX) käytöstä, jotta asiakkaat näkevät vain yhden ostoskorin."

msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d tuote"
msgstr[1] "%d tuotetta"
